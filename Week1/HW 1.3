import SwiftUI

struct Task: Identifiable {
    let id = UUID()
    var title: String
    var category: String
    var isCompleted: Bool
    var time: String
}

struct ContentView: View {

    @State private var tasks = [
        Task(title: "Read chapter 2", category: "Study", isCompleted: false, time: "09:00"),
        Task(title: "Workout", category: "Health", isCompleted: true, time: "17:00"),
        Task(title: "Finish lab report", category: "Work", isCompleted: false, time: "20:00"),
        Task(title: "Call family", category: "Personal", isCompleted: false, time: "21:00")
    ]

    var body: some View {

        VStack(spacing: 0) {

            ZStack {

                Rectangle()
                    .fill(Color.blue.opacity(0.15))
                    .frame(height: 170)

                VStack(spacing: 8) {

                    Text("Good Morning")
                        .font(.title2)

                    Text("Nguyen Van A")
                        .font(.largeTitle)
                        .bold()

                    Text("Discipline today creates a brighter tomorrow.")
                        .foregroundColor(.green)

                    Text(Date(), style: .date)
                        .font(.caption)
                }
            }

            HStack {

                Text("My Tasks")
                    .font(.title2)
                    .bold()

                Spacer()

                Button {
                    tasks.append(
                        Task(
                            title: "New Task",
                            category: "Personal",
                            isCompleted: false,
                            time: "22:00"
                        )
                    )
                } label: {
                    Label("Add Task", systemImage: "plus")
                }
            }
            .padding()

            List {

                ForEach($tasks) { $task in

                    HStack {

                        Button {
                            task.isCompleted.toggle()
                        } label: {
                            Image(
                                systemName: task.isCompleted
                                ? "checkmark.circle.fill"
                                : "circle"
                            )
                            .foregroundColor(
                                task.isCompleted ? .green : .gray
                            )
                            .font(.title2)
                        }

                        VStack(alignment: .leading, spacing: 4) {

                            TextField(
                                "Task Title",
                                text: $task.title
                            )
                            .textFieldStyle(.roundedBorder)

                            TextField(
                                "Category",
                                text: $task.category
                            )
                            .textFieldStyle(.roundedBorder)
                            .font(.caption)

                            TextField(
                                "Time",
                                text: $task.time
                            )
                            .textFieldStyle(.roundedBorder)
                            .font(.caption)
                        }

                        Spacer()
                    }
                    .padding(.vertical, 4)
                }
                .onDelete { indexSet in
                    tasks.remove(atOffsets: indexSet)
                }
            }

            HStack {

                Spacer()

                VStack {
                    Image(systemName: "house.fill")
                    Text("Today")
                        .font(.caption)
                }

                Spacer()

                VStack {
                    Image(systemName: "chart.bar.fill")
                    Text("Stats")
                        .font(.caption)
                }

                Spacer()

                VStack {
                    Image(systemName: "gearshape.fill")
                    Text("Settings")
                        .font(.caption)
                }

                Spacer()
            }
            .padding()
            .background(Color(.systemGray6))
        }
    }
}

#Preview {
    ContentView()
}

